# MongoDB Connection (external)
# Format: mongodb://username:password@host:port/?authSource=admin
MONGODB_URI=mongodb://localhost:27017

# Database
DATABASE_NAME=routing_db

# API Configuration
API_PORT=8000

# CORS Configuration (comma-separated list)
# Add your client origins here
# Example: http://localhost:9000,https://app.hitc.vn,http://192.168.100.92:9000
CORS_ORIGINS=http://localhost:9000,http://localhost:3000,http://192.168.100.92:9000,https://app.hitc.vn

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO